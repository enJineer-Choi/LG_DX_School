<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lg.model.DAO">
  
 	<insert id="join" parameterType="com.lg.model.VO">
 		insert into web_member values(#{id}, #{pw}, #{nick})
 	</insert>
 	<select id = "login" parameterType = "com.lg.model.VO" resultType = "com.lg.model.VO">
 		select * from web_member where id= #{id} and pw = #{pw}
 		<!-- 필드명을 작성할 때는 #{}으로 작성 : 우리가 VO 객체를 통해 (즉, 입력을 통해
 		받아온 값을 전달하는 과정 -->
 	</select>
 	
 	
 	<update id="update" parameterType = "com.lg.model.VO">
 		update web_member set pw = #{pw}, nick = #{nick} where id = #{id}
 	</update>
 	
 	<delete id="delete" parameterType = "String"> 
 	<!-- parameterType은 String -->
 		delete web_member where id = #{id}
 	</delete>
 	
</mapper>